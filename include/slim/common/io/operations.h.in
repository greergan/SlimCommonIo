#pragma once
#include <sys/socket.h>
#include <sys/stat.h>
#include <fcntl.h>
#include <cstdint>
#include <span>
#include <string_view>
#include <linux/io_uring.h>
#include <slim/common/io/awaitable.h>
#define SLIMCOMMONIO_VERSION  "@SLIMCOMMONIO_VERSION@"
#define SLIMCOMMONIO_GIT_HASH "@SLIMCOMMONIO_GIT_HASH@"
namespace slim::common::io {
class Scheduler;
struct Accept : Awaitable {
    int              server_fd_;
    sockaddr_storage addr_{};
    socklen_t        addr_len_{sizeof(addr_)};
    Accept(Scheduler& scheduler, int server_fd);
protected:
    void prepare(io_uring_sqe* sqe) noexcept override;
};
struct Close : Awaitable {
    int fd_;
    Close(Scheduler& scheduler, int fd);
protected:
    void prepare(io_uring_sqe* sqe) noexcept override;
};
struct Connect : Awaitable {
    int              fd_;
    sockaddr_storage addr_{};
    socklen_t        addr_len_{0};
    Connect(Scheduler& scheduler, int fd, const sockaddr* addr, socklen_t addr_len);
protected:
    void prepare(io_uring_sqe* sqe) noexcept override;
};
struct Open : Awaitable {
    int              dfd_;
    std::string_view path_;
    int              flags_;
    mode_t           mode_;
    Open(Scheduler& scheduler, std::string_view path, int flags, mode_t mode = 0644, int dfd = AT_FDCWD);
protected:
    void prepare(io_uring_sqe* sqe) noexcept override;
};
struct Poll : Awaitable {
    int      fd_;
    uint32_t poll_mask_; // POLLIN, POLLOUT, etc. -- same bitmask as poll(2)
    Poll(Scheduler& scheduler, int fd, uint32_t poll_mask);
protected:
    void prepare(io_uring_sqe* sqe) noexcept override;
};
struct Read : Awaitable {
    int                  fd_;
    std::span<uint32_t>  buf_;
    uint64_t             offset_;
    Read(Scheduler& scheduler, int fd, std::span<uint32_t> buf, uint64_t offset = 0);
protected:
    void prepare(io_uring_sqe* sqe) noexcept override;
};
struct Recv : Awaitable {
    int    fd_;
    void*  buf_;
    size_t len_;
    int    flags_;
    Recv(Scheduler& scheduler, int fd, void* buf, size_t len, int flags = 0);
protected:
    void prepare(io_uring_sqe* sqe) noexcept override;
};
struct Send : Awaitable {
    int         fd_;
    const void* buf_;
    size_t      len_;
    int         flags_;
    Send(Scheduler& scheduler, int fd, const void* buf, size_t len, int flags = 0);
protected:
    void prepare(io_uring_sqe* sqe) noexcept override;
};
struct Stat : Awaitable {
    int              dfd_;
    std::string_view path_;
    struct statx     buf_{};
    int              flags_;
    uint32_t         mask_;
    Stat(Scheduler& scheduler, std::string_view path, int flags = 0, uint32_t mask = STATX_BASIC_STATS, int dfd = AT_FDCWD);
protected:
    void prepare(io_uring_sqe* sqe) noexcept override;
};
struct Write : Awaitable {
    int                        fd_;
    std::span<const uint32_t>  buf_;
    uint64_t                   offset_;
    Write(Scheduler& scheduler, int fd, std::span<const uint32_t> buf, uint64_t offset = 0);
protected:
    void prepare(io_uring_sqe* sqe) noexcept override;
};
} // namespace slim::common::io
